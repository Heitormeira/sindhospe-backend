rules_version = '2';

// Portal SINDHOSPE — regras do Firestore.
// Tudo que não está liberado aqui é negado. Os dados são gravados só pelo
// importador (Admin SDK, que ignora estas regras).
// Perfis (custom claims definidas pelo importador):
//   { cnes: "<CNES>" }        associado: vê só o próprio estabelecimento
//   { perfil: "sindicato" }   SINDHOSPE: vê o painel consolidado e todos os associados
service cloud.firestore {
  match /databases/{db}/documents {
    function associado() { return request.auth != null && request.auth.token.cnes is string; }
    function sindicato() { return request.auth != null && request.auth.token.perfil == 'sindicato'; }
    function logado() { return associado() || sindicato(); }

    // Ficha + evolução: o dono do CNES ou o sindicato.
    match /associados/{cnes} {
      allow get: if (associado() && request.auth.token.cnes == cnes) || sindicato();
    }

    match /mercado/{id}  { allow get: if logado(); }
    match /publico/{id}  { allow get: if logado(); }

    // Painel consolidado dos associados: só o sindicato.
    match /sindicato/{id} { allow get: if sindicato(); }

    // Busca do login: sem login, só consultas de até 8 resultados.
    match /busca/{cnes} {
      allow list: if request.query.limit <= 8;
    }

    // Pedido de revisão: o associado cria para o próprio CNES; só o sindicato lê.
    match /solicitacoes_revisao/{id} {
      allow read: if sindicato();
      allow create: if associado()
        && request.resource.data.keys().hasOnly(['cnes', 'nome', 'mensagem', 'criado_em'])
        && request.resource.data.cnes == request.auth.token.cnes
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 200
        && (!('mensagem' in request.resource.data)
            || (request.resource.data.mensagem is string
                && request.resource.data.mensagem.size() <= 2000))
        && request.resource.data.criado_em == request.time;
    }
  }
}
